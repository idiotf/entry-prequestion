{
  "name": "entry-prequestion",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "typescript": "^6"
  },
  "scripts": {
    "build:temp": "rm -rf build/dist && bun build src/index.ts --outdir build/dist --minify",
